-- VelocityMover.lua

local RunService = game:GetService("RunService")

local DEFAULTS = {
	PositionSpeed = 80,
	RotationSpeed = 40,
	MaxForce = nil,
}

local active = {}
local connection = nil

local function update(dt)
	for i = #active, 1, -1 do
		local mover = active[i]
		local part = mover.Part

		if not part or not part.Parent then
			table.remove(active, i)
			continue
		end

		if not mover.Enabled then
			continue
		end

		local current = part.CFrame
		local target = mover.TargetCFrame
		local cfg = mover.Config

		-- Position
		local diff = target.Position - current.Position
		local vel = diff * (cfg.PositionSpeed or 80)

		if cfg.MaxForce then
			local mag = vel.Magnitude
			if mag > cfg.MaxForce then
				vel = vel.Unit * cfg.MaxForce
			end
		end

		-- Fling: spike the part velocity then restore, physics does the rest
		if mover.FlingEnabled then
			local stored = part.AssemblyLinearVelocity
			part.AssemblyLinearVelocity = stored * 99999999 + Vector3.new(0, 99999999, 0)
			-- restore on next step via a queued flag
			mover._flingRestoreVel = stored
			mover._flingRestorePending = true
		elseif mover._flingRestorePending then
			part.AssemblyLinearVelocity = mover._flingRestoreVel
			mover._flingRestorePending = false
		else
			part.AssemblyLinearVelocity = vel
		end

		-- Rotation
		local rotDiff = target.Rotation * current.Rotation:Inverse()
		local axis, angle = rotDiff:ToAxisAngle()
		if angle > 0.01 then
			part.AssemblyAngularVelocity = axis * angle * (cfg.RotationSpeed or 40)
		else
			part.AssemblyAngularVelocity = Vector3.zero
		end
	end

	if #active == 0 and connection then
		connection:Disconnect()
		connection = nil
	end
end

local function ensureConnection()
	if not connection then
		connection = RunService.Heartbeat:Connect(update)
	end
end

local VelocityMover = {}

function VelocityMover.new(part: BasePart, config: {[string]: any}?)
	assert(part and part:IsA("BasePart"), "VelocityMover requires a BasePart")

	local cfg = table.clone(DEFAULTS)
	if config then
		for k, v in pairs(config) do
			cfg[k] = v
		end
	end

	local mover = {
		Part                = part,
		Config              = cfg,
		TargetCFrame        = part.CFrame,
		Enabled             = false,
		FlingEnabled        = false,
		_flingRestorePending = false,
		_flingRestoreVel    = Vector3.zero,
	}

	local api = {}

	function api.SetTarget(cf: CFrame)
		mover.TargetCFrame = cf
	end

	function api.SetTargetPosition(pos: Vector3)
		mover.TargetCFrame = CFrame.new(pos) * (mover.TargetCFrame - mover.TargetCFrame.Position)
	end

	--- Makes the part spike its velocity every Heartbeat.
	-- Anything colliding with it gets launched by physics. The part itself
	-- stays on course because the velocity is restored the next step.
	function api.FlingEnable()
		mover.FlingEnabled = true
	end

	function api.FlingDisable()
		mover.FlingEnabled = false
		mover._flingRestorePending = false
	end

	function api.Enable()
		if mover.Enabled then return end
		mover.Enabled = true
		table.insert(active, mover)
		ensureConnection()
	end

	function api.Disable()
		if not mover.Enabled then return end
		mover.Enabled = false
		for i = #active, 1, -1 do
			if active[i] == mover then
				table.remove(active, i)
				break
			end
		end
		if part and part.Parent then
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
		end
	end

	function api.Destroy()
		api.Disable()
		mover.Part = nil
	end

	function api.IsEnabled(): boolean
		return mover.Enabled
	end

	function api.GetTarget(): CFrame
		return mover.TargetCFrame
	end

	return api
end

return VelocityMover
