-- VelocityMover.lua using BodyVelocity + BodyGyro

local RunService = game:GetService("RunService")

local DEFAULTS = {
	MaxForce = 500,
	MaxTorque = 500,
	P = 3000,
	D = 300,
}

local active = {}
local connection = nil

local function update()
	for i = #active, 1, -1 do
		local mover = active[i]
		local part = mover.Part

		if not part or not part.Parent then
			table.remove(active, i)
			continue
		end

		if not mover.Enabled then
			continue
		end

		local target = mover.TargetCFrame

		-- Reset velocity every frame to prevent accumulation
		part.AssemblyLinearVelocity = Vector3.zero
		part.AssemblyAngularVelocity = Vector3.zero

		-- Update BodyVelocity target using P controller
		local diff = target.Position - part.Position
		mover.BodyVelocity.Velocity = diff * 100

		-- Update BodyGyro target
		mover.BodyGyro.CFrame = target
	end

	if #active == 0 and connection then
		connection:Disconnect()
		connection = nil
	end
end

local function ensureConnection()
	if not connection then
		connection = RunService.Heartbeat:Connect(update)
	end
end

local VelocityMover = {}

function VelocityMover.new(part, config)
	assert(part and part:IsA("BasePart"), "VelocityMover requires a BasePart")

	local cfg = {}
	for k, v in pairs(DEFAULTS) do
		cfg[k] = v
	end
	if config then
		for k, v in pairs(config) do
			cfg[k] = v
		end
	end

	-- BodyVelocity for position
	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(cfg.MaxForce, cfg.MaxForce, cfg.MaxForce)
	bv.Velocity = Vector3.zero
	bv.P = cfg.P
	bv.Enabled = false
	bv.Parent = part

	-- BodyGyro for rotation
	local bg = Instance.new("BodyGyro")
	bg.MaxTorque = Vector3.new(cfg.MaxTorque, cfg.MaxTorque, cfg.MaxTorque)
	bg.CFrame = part.CFrame
	bg.P = cfg.P
	bg.D = cfg.D
	bg.Enabled = false
	bg.Parent = part

	local mover = {
		Part = part,
		Config = cfg,
		TargetCFrame = part.CFrame,
		Enabled = false,
		BodyVelocity = bv,
		BodyGyro = bg,
	}

	local api = {}

	function api.SetTarget(cf)
		mover.TargetCFrame = cf
	end

	function api.SetTargetPosition(pos)
		mover.TargetCFrame = CFrame.new(pos) * (mover.TargetCFrame - mover.TargetCFrame.Position)
	end

	function api.Enable()
		if mover.Enabled then return end
		mover.Enabled = true
		mover.BodyVelocity.Enabled = true
		mover.BodyGyro.Enabled = true
		table.insert(active, mover)
		ensureConnection()
	end

	function api.Disable()
		if not mover.Enabled then return end
		mover.Enabled = false

		for i = #active, 1, -1 do
			if active[i] == mover then
				table.remove(active, i)
				break
			end
		end

		mover.BodyVelocity.Enabled = false
		mover.BodyGyro.Enabled = false
	end

	function api.Destroy()
		api.Disable()
		if mover.BodyVelocity then mover.BodyVelocity:Destroy() end
		if mover.BodyGyro then mover.BodyGyro:Destroy() end
		mover.Part = nil
	end

	function api.IsEnabled()
		return mover.Enabled
	end

	function api.GetTarget()
		return mover.TargetCFrame
	end

	function api.SetConfig(key, value)
		mover.Config[key] = value
	end

	function api.GetConfig(key)
		return mover.Config[key]
	end

	return api
end

return VelocityMover
